--[[
    NeverLib — Neverlose-style minimalist UI library for Roblox executors
    Layout : left sidebar (tabs) + right content area
    API     : CSGUI:CreateWindow(title, size?) → Window
              Window:AddTab(name) → Tab
              Tab:AddToggle(text, default, cb) → obj
              Tab:AddSlider(text, min, max, default, cb) → obj
              Tab:AddButton(text, cb)
              Tab:AddLabel(text) → TextLabel
              Tab:AddSeparator()
]]

local CSGUI = {}
CSGUI.__index = CSGUI

-- ── Services ───────────────────────────────────────────────────────────────
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local Players          = game:GetService("Players")
local CoreGui          = game:GetService("CoreGui")
local LocalPlayer      = Players.LocalPlayer

-- ── Theme ──────────────────────────────────────────────────────────────────
-- Neverlose palette: near-black bg, slate sidebar, blue/violet accent,
-- muted sub-text, razor-thin borders.
local T = {
    BG          = Color3.fromRGB(10,  10,  13),   -- main window bg
    Sidebar     = Color3.fromRGB(14,  14,  18),   -- left panel
    Item        = Color3.fromRGB(18,  18,  23),   -- toggle / slider / button bg
    ItemHover   = Color3.fromRGB(23,  23,  30),   -- hovered item bg
    Accent      = Color3.fromRGB(108, 101, 228),  -- NL purple-blue
    AccentDim   = Color3.fromRGB(60,  57,  130),  -- dimmed accent (inactive toggle track)
    Text        = Color3.fromRGB(215, 215, 225),  -- primary text
    SubText     = Color3.fromRGB(85,  85,  105),  -- secondary / hint text
    TabText     = Color3.fromRGB(100, 100, 122),  -- inactive tab label
    Divider     = Color3.fromRGB(26,  26,  34),   -- divider / border lines
    Danger      = Color3.fromRGB(220, 75,  75),
    White       = Color3.fromRGB(255, 255, 255),
    Font        = Enum.Font.GothamMedium,
    FontBold    = Enum.Font.GothamBold,
    FontSemi    = Enum.Font.Gotham,
    CornerSm    = UDim.new(0, 4),
    CornerMd    = UDim.new(0, 6),
    CornerFull  = UDim.new(1, 0),
}

-- ── Helpers ────────────────────────────────────────────────────────────────
local function New(class, props, children)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    if children then
        for _, child in ipairs(children) do
            child.Parent = inst
        end
    end
    return inst
end

local function Corner(r, parent)
    return New("UICorner", {CornerRadius = r or T.CornerSm, Parent = parent})
end

local function Stroke(color, thickness, parent)
    return New("UIStroke", {Color = color or T.Divider, Thickness = thickness or 1, Parent = parent})
end

local function Tween(inst, props, t, style, dir)
    local info = TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out)
    local tw   = TweenService:Create(inst, info, props)
    tw:Play()
    return tw
end

-- ── Tab object ─────────────────────────────────────────────────────────────
local Tab = {}
Tab.__index = Tab

-- Separator line
function Tab:AddSeparator()
    New("Frame", {
        Size             = UDim2.new(1, -8, 0, 1),
        BackgroundColor3 = T.Divider,
        BorderSizePixel  = 0,
        Parent           = self.Content,
    })
end

-- Plain label
function Tab:AddLabel(text)
    local lbl = New("TextLabel", {
        Size                  = UDim2.new(1, -8, 0, 22),
        BackgroundTransparency = 1,
        Text                  = text,
        TextColor3            = T.SubText,
        Font                  = T.FontSemi,
        TextSize              = 12,
        TextXAlignment        = Enum.TextXAlignment.Left,
        Parent                = self.Content,
    })
    return lbl
end

-- Toggle
function Tab:AddToggle(text, default, callback)
    local on = default == true

    local row = New("Frame", {
        Size             = UDim2.new(1, -8, 0, 34),
        BackgroundColor3 = T.Item,
        Parent           = self.Content,
    })
    Corner(T.CornerMd, row)
    Stroke(T.Divider, 1, row)

    New("TextLabel", {
        Size                  = UDim2.new(1, -58, 1, 0),
        Position              = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                  = text,
        TextColor3            = T.Text,
        Font                  = T.Font,
        TextSize              = 13,
        TextXAlignment        = Enum.TextXAlignment.Left,
        Parent                = row,
    })

    -- track
    local track = New("Frame", {
        Size             = UDim2.new(0, 34, 0, 16),
        Position         = UDim2.new(1, -46, 0.5, -8),
        BackgroundColor3 = on and T.Accent or T.AccentDim,
        Parent           = row,
    })
    Corner(T.CornerFull, track)

    -- knob
    local knob = New("Frame", {
        Size             = UDim2.new(0, 12, 0, 12),
        Position         = UDim2.new(0, on and 20 or 2, 0.5, -6),
        BackgroundColor3 = T.White,
        Parent           = track,
    })
    Corner(T.CornerFull, knob)

    -- click area
    local btn = New("TextButton", {
        Size                  = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                  = "",
        Parent                = row,
    })

    btn.MouseEnter:Connect(function()
        Tween(row, {BackgroundColor3 = T.ItemHover})
    end)
    btn.MouseLeave:Connect(function()
        Tween(row, {BackgroundColor3 = T.Item})
    end)
    btn.MouseButton1Click:Connect(function()
        on = not on
        Tween(knob,  {Position = UDim2.new(0, on and 20 or 2, 0.5, -6)})
        Tween(track, {BackgroundColor3 = on and T.Accent or T.AccentDim})
        if callback then callback(on) end
    end)

    return {
        Set = function(_, state)
            on = state
            knob.Position       = UDim2.new(0, on and 20 or 2, 0.5, -6)
            track.BackgroundColor3 = on and T.Accent or T.AccentDim
        end,
        Get = function() return on end,
    }
end

-- Slider
function Tab:AddSlider(text, min, max, default, callback)
    local val = math.clamp(default or min, min, max)

    local row = New("Frame", {
        Size             = UDim2.new(1, -8, 0, 50),
        BackgroundColor3 = T.Item,
        Parent           = self.Content,
    })
    Corner(T.CornerMd, row)
    Stroke(T.Divider, 1, row)

    New("TextLabel", {
        Size                  = UDim2.new(1, -60, 0, 18),
        Position              = UDim2.new(0, 12, 0, 5),
        BackgroundTransparency = 1,
        Text                  = text,
        TextColor3            = T.Text,
        Font                  = T.Font,
        TextSize              = 13,
        TextXAlignment        = Enum.TextXAlignment.Left,
        Parent                = row,
    })

    local valLbl = New("TextLabel", {
        Size                  = UDim2.new(0, 50, 0, 18),
        Position              = UDim2.new(1, -62, 0, 5),
        BackgroundTransparency = 1,
        Text                  = tostring(val),
        TextColor3            = T.Accent,
        Font                  = T.FontBold,
        TextSize              = 12,
        TextXAlignment        = Enum.TextXAlignment.Right,
        Parent                = row,
    })

    -- track bg
    local trackBg = New("Frame", {
        Size             = UDim2.new(1, -24, 0, 4),
        Position         = UDim2.new(0, 12, 0, 36),
        BackgroundColor3 = T.Divider,
        Parent           = row,
    })
    Corner(T.CornerFull, trackBg)

    -- fill
    local fill = New("Frame", {
        Size             = UDim2.new((val - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.Accent,
        Parent           = trackBg,
    })
    Corner(T.CornerFull, fill)

    -- knob dot on fill end
    local dot = New("Frame", {
        Size             = UDim2.new(0, 10, 0, 10),
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new((val - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = T.White,
        Parent           = trackBg,
    })
    Corner(T.CornerFull, dot)

    local function setVal(px)
        local pct = math.clamp((px - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        val = math.floor(min + (max - min) * pct + 0.5)
        local frac = (val - min) / (max - min)
        fill.Size     = UDim2.new(frac, 0, 1, 0)
        dot.Position  = UDim2.new(frac, 0, 0.5, 0)
        valLbl.Text   = tostring(val)
        if callback then callback(val) end
    end

    local dragging = false
    local hitbox = New("TextButton", {
        Size                  = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                  = "",
        Parent                = row,
    })
    hitbox.MouseEnter:Connect(function() Tween(row, {BackgroundColor3 = T.ItemHover}) end)
    hitbox.MouseLeave:Connect(function() Tween(row, {BackgroundColor3 = T.Item}) end)
    hitbox.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            setVal(inp.Position.X)
        end
    end)
    hitbox.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            setVal(inp.Position.X)
        end
    end)

    return { Get = function() return val end }
end

-- Button
function Tab:AddButton(text, callback)
    local btn = New("TextButton", {
        Size             = UDim2.new(1, -8, 0, 34),
        BackgroundColor3 = T.Item,
        Text             = text,
        TextColor3       = T.Text,
        Font             = T.Font,
        TextSize         = 13,
        AutoButtonColor  = false,
        Parent           = self.Content,
    })
    Corner(T.CornerMd, btn)
    local stroke = Stroke(T.Divider, 1, btn)

    btn.MouseEnter:Connect(function()
        Tween(btn,    {BackgroundColor3 = T.ItemHover})
        Tween(stroke, {Color = T.Accent})
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn,    {BackgroundColor3 = T.Item})
        Tween(stroke, {Color = T.Divider})
    end)
    btn.MouseButton1Click:Connect(function()
        -- brief flash
        local flash = New("Frame", {
            Size                  = UDim2.new(1, 0, 1, 0),
            BackgroundColor3      = T.Accent,
            BackgroundTransparency = 0.7,
            Parent                = btn,
        })
        Corner(T.CornerMd, flash)
        Tween(flash, {BackgroundTransparency = 1}, 0.35).Completed:Connect(function() flash:Destroy() end)
        if callback then callback() end
    end)
    return btn
end

-- ── Window ─────────────────────────────────────────────────────────────────
local Window = {}
Window.__index = Window

function Window:AddTab(name)
    -- ── sidebar tab button
    local btnFrame = New("Frame", {
        Size             = UDim2.new(1, -16, 0, 30),
        BackgroundColor3 = T.Sidebar,   -- overridden when active
        Parent           = self._tabList,
    })
    Corner(T.CornerMd, btnFrame)

    -- left accent bar (visible when active)
    local bar = New("Frame", {
        Size             = UDim2.new(0, 2, 0.6, 0),
        Position         = UDim2.new(0, 0, 0.2, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel  = 0,
        BackgroundTransparency = 1,  -- hidden by default
        Parent           = btnFrame,
    })
    Corner(T.CornerFull, bar)

    local btnLbl = New("TextLabel", {
        Size                  = UDim2.new(1, -12, 1, 0),
        Position              = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                  = name,
        TextColor3            = T.TabText,
        Font                  = T.Font,
        TextSize              = 13,
        TextXAlignment        = Enum.TextXAlignment.Left,
        Parent                = btnFrame,
    })

    local btn = New("TextButton", {
        Size                  = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                  = "",
        Parent                = btnFrame,
    })

    -- ── content scroll frame
    local scroll = New("ScrollingFrame", {
        Size                  = UDim2.new(1, -16, 1, -16),
        Position              = UDim2.new(0, 8, 0, 8),
        BackgroundTransparency = 1,
        ScrollBarThickness    = 2,
        ScrollBarImageColor3  = T.Accent,
        CanvasSize            = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize   = Enum.AutomaticSize.Y,
        Visible               = false,
        Parent                = self._contentArea,
    })
    New("UIListLayout", {
        Padding         = UDim.new(0, 6),
        SortOrder       = Enum.SortOrder.LayoutOrder,
        Parent          = scroll,
    })
    New("UIPadding", {
        PaddingLeft   = UDim.new(0, 4),
        PaddingRight  = UDim.new(0, 4),
        PaddingTop    = UDim.new(0, 4),
        Parent        = scroll,
    })

    local tabObj = setmetatable({Content = scroll, _btn = btn, _bar = bar, _lbl = btnLbl, _frame = btnFrame, _win = self}, Tab)

    btn.MouseButton1Click:Connect(function()
        self:_selectTab(tabObj)
    end)

    table.insert(self._tabs, tabObj)
    if #self._tabs == 1 then
        self:_selectTab(tabObj)
    end

    return tabObj
end

function Window:_selectTab(target)
    for _, t in ipairs(self._tabs) do
        local active = (t == target)
        t.Content.Visible = active
        Tween(t._lbl,   {TextColor3 = active and T.Text or T.TabText})
        Tween(t._bar,   {BackgroundTransparency = active and 0 or 1})
        Tween(t._frame, {BackgroundColor3 = active and T.ItemHover or T.Sidebar})
    end
end

-- ── CreateWindow ───────────────────────────────────────────────────────────
function CSGUI:CreateWindow(title, size)
    size = size or Vector2.new(560, 370)

    local Connections = {}
    local ToggleKey   = Enum.KeyCode.Insert

    -- ScreenGui
    local sg = New("ScreenGui", {
        Name              = "NeverLib_" .. math.random(1000, 9999),
        ResetOnSpawn      = false,
        ZIndexBehavior    = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset    = true,
        Parent            = (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui")) or CoreGui,
    })

    -- ── Main frame ────────────────────────────────────────────────────────
    local main = New("Frame", {
        Size             = UDim2.fromOffset(size.X, size.Y),
        Position         = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2),
        BackgroundColor3 = T.BG,
        ClipsDescendants = true,
        Parent           = sg,
    })
    Corner(UDim.new(0, 6), main)
    Stroke(T.Divider, 1, main)

    -- ── Left sidebar ──────────────────────────────────────────────────────
    local SIDEBAR_W = 160
    local sidebar = New("Frame", {
        Size             = UDim2.new(0, SIDEBAR_W, 1, 0),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel  = 0,
        Parent           = main,
    })
    -- right border line
    New("Frame", {
        Size             = UDim2.new(0, 1, 1, 0),
        Position         = UDim2.new(1, -1, 0, 0),
        BackgroundColor3 = T.Divider,
        BorderSizePixel  = 0,
        Parent           = sidebar,
    })

    -- window title in sidebar header
    New("TextLabel", {
        Size                  = UDim2.new(1, -16, 0, 44),
        Position              = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text                  = title:upper(),
        TextColor3            = T.Text,
        Font                  = T.FontBold,
        TextSize              = 13,
        TextXAlignment        = Enum.TextXAlignment.Left,
        Parent                = sidebar,
    })

    -- thin line under title
    New("Frame", {
        Size             = UDim2.new(1, -16, 0, 1),
        Position         = UDim2.new(0, 8, 0, 44),
        BackgroundColor3 = T.Divider,
        BorderSizePixel  = 0,
        Parent           = sidebar,
    })

    -- tab list
    local tabList = New("Frame", {
        Size             = UDim2.new(1, 0, 1, -56),
        Position         = UDim2.new(0, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent           = sidebar,
    })
    New("UIListLayout", {
        Padding   = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent    = tabList,
    })
    New("UIPadding", {
        PaddingLeft  = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingTop   = UDim.new(0, 6),
        Parent       = tabList,
    })

    -- ── Right content area ────────────────────────────────────────────────
    local contentArea = New("Frame", {
        Size             = UDim2.new(1, -SIDEBAR_W, 1, 0),
        Position         = UDim2.new(0, SIDEBAR_W, 0, 0),
        BackgroundTransparency = 1,
        Parent           = main,
    })

    -- ── Drag (drag by sidebar header) ─────────────────────────────────────
    do
        local dragging, dStart, dPos
        local header = New("TextButton", {
            Size                  = UDim2.new(1, 0, 0, 44),
            BackgroundTransparency = 1,
            Text                  = "",
            Parent                = sidebar,
        })
        header.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dStart   = inp.Position
                dPos     = main.Position
            end
        end)
        header.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        table.insert(Connections, UserInputService.InputChanged:Connect(function(inp)
            if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                local d = inp.Position - dStart
                main.Position = UDim2.new(dPos.X.Scale, dPos.X.Offset + d.X, dPos.Y.Scale, dPos.Y.Offset + d.Y)
            end
        end))
    end

    -- ── Toggle visibility ─────────────────────────────────────────────────
    local visible = true
    table.insert(Connections, UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == ToggleKey then
            visible     = not visible
            sg.Enabled  = visible
        end
    end))

    -- ── Window object ─────────────────────────────────────────────────────
    local winObj = setmetatable({
        Gui          = sg,
        Main         = main,
        _contentArea = contentArea,
        _tabList     = tabList,
        _tabs        = {},
        Connections  = Connections,
    }, Window)

    return winObj
end

return CSGUI
