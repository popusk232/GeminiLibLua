        local wf = WatermarkGui:FindFirstChildOfClass("Frame")
        if wf then
            wf.Position = UDim2.new(0.5, -200, 0, -40)
            tween(wf, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -200, 0, 10)})
        end
        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
            UIScale = 1.3
            FrameSize = UDim2.new(0, 400, 0, 280)
            FramePos = UDim2.new(0.5, -200, 0.5, -140)
            SidebarWidth = 110
            MacBtnSize = UDim2.new(0, 16, 0, 16)
            MacBtnOffset = 28
            MainFrame.Size = FrameSize
            MainFrame.Position = FramePos
            Sidebar.Size = UDim2.new(0, SidebarWidth, 1, -40)
            Container.Size = UDim2.new(1, -SidebarWidth - 25, 1, -55)
            Container.Position = UDim2.new(0, SidebarWidth + 15, 0, 50)
            Divider.Position = UDim2.new(0, SidebarWidth + 5, 0, 45)
        end
    end
    local ESPFolder = Instance.new("Folder", CoreGui)
    ESPFolder.Name = "GeminiESP"
    local function isInvisible(plr)
        if not plr.Character then return false end
        local head = plr.Character:FindFirstChild("Head")
        if head and head.Transparency > 0.5 then return true end
        for _, part in pairs(plr.Character:GetChildren()) do if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency > 0.5 then return true end end
        return false
    end
    local function createESP(plr)
        if plr == player then return end
        local espFolder = Instance.new("Folder", ESPFolder)
        espFolder.Name = plr.Name
        local function updateESP()
            if not _G.GeminiConfig.ESPEnabled or not plr.Character then for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end return end
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end
            local billboard = Instance.new("BillboardGui", espFolder)
            billboard.Adornee = hrp
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            local invis = isInvisible(plr)
            local nameColor = invis and Theme.Invisible or Theme.Accent
            local nameLabel = Instance.new("TextLabel", billboard)
            nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = plr.Name .. (invis and " [I]" or "")
            nameLabel.TextColor3 = nameColor
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 14
            nameLabel.TextStrokeTransparency = 0.5
            local distLabel = Instance.new("TextLabel", billboard)
            distLabel.Size = UDim2.new(1, 0, 0.5, 0)
            distLabel.Position = UDim2.new(0, 0, 0.5, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.TextColor3 = Theme.SubText
            distLabel.Font = Enum.Font.Gotham
            distLabel.TextSize = 12
            distLabel.TextStrokeTransparency = 0.5
            local highlight = Instance.new("Highlight", espFolder)
            highlight.Adornee = plr.Character
            highlight.FillColor = nameColor
            highlight.OutlineColor = nameColor
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            local conn
            conn = RunService.RenderStepped:Connect(function()
                if not _G.GeminiConfig.ESPEnabled or not plr.Character or not player.Character then if conn then conn:Disconnect() end return end
                local myHrp = player.Character:FindFirstChild("HumanoidRootPart")
                if myHrp and hrp then distLabel.Text = math.floor((myHrp.Position - hrp.Position).Magnitude) .. " studs" end
            end)
        end
        plr.CharacterAdded:Connect(function() task.wait(0.5) updateESP() end)
        updateESP()
    end
    function Window:SetupESP()
        for _, plr in pairs(Players:GetPlayers()) do createESP(plr) end
        Players.PlayerAdded:Connect(createESP)
        Players.PlayerRemoving:Connect(function(plr) local f = ESPFolder:FindFirstChild(plr.Name) if f then f:Destroy() end end)
    end
    task.spawn(function()
        while task.wait(0.1) do
            if _G.GeminiConfig.FarmEnabled and player.Character then
                pcall(function()
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local target, minP = nil, 99
                        local priorities = {Secret = 1, Godly = 2, Mythic = 3, Legendary = 4, Epic = 5, Rare = 6, Uncommon = 7, Common = 8}
                        for _, v in pairs(workspace:GetChildren()) do
                            if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                                local r = v:GetAttribute("Rarity") or "Common"
                                if _G.GeminiConfig.SelectedRarities[r] and priorities[r] and priorities[r] < minP then minP = priorities[r] target = v end
                            end
                        end
                        if target then
                            root.CFrame = target:GetPivot() * CFrame.new(0, 3, 0)
                            task.wait(0.2)
                            local det = target:FindFirstChildOfClass("ClickDetector") or target:FindFirstChild("ClickDetector", true)
                            if det and fireclickdetector then fireclickdetector(det) end
                            task.wait(_G.GeminiConfig.TweenSpeed / 1000)
                        end
                    end
                end)
            end
        end
    end)
    task.spawn(function()
        while task.wait(1) do
            local count = 0
            local children = workspace:GetChildren()
            for i = 1, #children do
                local v = children[i]
                if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                    local r = v:GetAttribute("Rarity") or "Common"
                    if _G.GeminiConfig.SelectedRarities[r] then count = count + 1 end
                end
            end
            StatusLabel.Text = "Target Crates: " .. count
        end
    end)
    _G.GeminiQuickLoot = function()
        local priorities = {Secret = 1, Godly = 2, Mythic = 3, Legendary = 4, Epic = 5, Rare = 6, Uncommon = 7, Common = 8}
        local best, minP = nil, 99
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                local r = v:GetAttribute("Rarity") or "Common"
                if _G.GeminiConfig.SelectedRarities[r] and priorities[r] and priorities[r] < minP then minP = priorities[r] best = v end
            end
        end
        if best and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                root.CFrame = best:GetPivot() * CFrame.new(0, 3, 0)
                task.wait(0.2)
                local det = best:FindFirstChildOfClass("ClickDetector") or best:FindFirstChild("ClickDetector", true)
                if det and fireclickdetector then fireclickdetector(det) end
            end
        end
    end
    return Window
end
return GeminiLib
