    StatusText.Size = UDim2.new(1, 0, 0, 20)
    StatusText.Position = UDim2.new(0, 0, 1, -28)
    StatusText.BackgroundTransparency = 1
    StatusText.Text = "Initializing"
    StatusText.TextColor3 = Theme.SubText
    StatusText.Font = Enum.Font.Gotham
    StatusText.TextSize = 12

    -- Частицы
    local function createParticle()
        local p = Instance.new("Frame", LoaderFrame)
        p.Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5))
        p.Position = UDim2.new(math.random(), 0, math.random(), 0)
        p.BackgroundColor3 = Theme.Accent
        p.BorderSizePixel = 0
        p.BackgroundTransparency = 0.4
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

        tween(p, TweenInfo.new(2 + math.random() * 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Position = UDim2.new(p.Position.X.Scale + math.random(-0.1, 0.1), 0, p.Position.Y.Scale + math.random(-0.1, 0.1), 0),
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 0, 0)
        })
        task.delay(3, function() p:Destroy() end)
    end

    task.spawn(function()
        while LoaderGui.Parent do
            createParticle()
            task.wait(0.25)
        end
    end)

    -- Пульсация кольца
    task.spawn(function()
        while LoaderGui.Parent do
            tween(RingFill, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0.92, 0, 0.92, 0),
                Position = UDim2.new(0.04, 0, 0.04, 0)
            })
            task.wait(1)
            tween(RingFill, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0.88, 0, 0.88, 0),
                Position = UDim2.new(0.06, 0, 0.06, 0)
            })
            task.wait(1)
        end
    end)

    -- Прогресс загрузки
    local steps = {
        {0, "Initializing core"},
        {15, "Loading modules"},
        {30, "Connecting to server"},
        {50, "Building interface"},
        {70, "Loading ESP system"},
        {85, "Finalizing"},
        {100, "Ready"}
    }

    local progress = 0
    local loadingActive = true

    task.spawn(function()
        for _, step in ipairs(steps) do
            local target, status = step[1], step[2]
            StatusText.Text = status

            while progress < target do
                progress = progress + 1
                PercentText.Text = progress .. "%"
                local scale = 0.72 + (progress / 100) * 0.16
                RingInner.Size = UDim2.new(scale, 0, scale, 0)
                RingInner.Position = UDim2.new((1 - scale) / 2, 0, (1 - scale) / 2, 0)
                task.wait(duration / 100)
            end
            task.wait(0.3)
        end

        task.wait(0.5)
        loadingActive = false

        -- Fade out
        tween(LoaderFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1})
        for _, child in pairs(Center:GetDescendants()) do
            if child:IsA("TextLabel") then
                tween(child, TweenInfo.new(0.6), {TextTransparency = 1})
            elseif child:IsA("Frame") and child ~= RingContainer then
                tween(child, TweenInfo.new(0.6), {BackgroundTransparency = 1})
            end
        end
        tween(RingContainer, TweenInfo.new(0.6), {Size = UDim2.new(0, 0, 0, 0)})

        task.wait(0.8)
        LoaderGui:Destroy()
    end)

    return LoaderGui
end

