    local MacBtns = Instance.new("Frame", TopBar)
    MacBtns.Size = UDim2.new(0, 70, 1, 0)
    MacBtns.Position = UDim2.new(0, 15, 0, 0)
    MacBtns.BackgroundTransparency = 1
    local function animateBtnHover(btn, color)
        btn.MouseEnter:Connect(function()
            tween(btn, TweenInfo.new(0.2), {Size = UDim2.new(0, 14, 0, 14)})
            tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = color:Lerp(Color3.fromRGB(255,255,255), 0.3)})
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, TweenInfo.new(0.2), {Size = UDim2.new(0, 12, 0, 12)})
            tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = color})
        end)
    end
    local isMinimized = false
    local originalTransparency = {}
    local function createMacBtn(color, xOffset, action)
        local btn = Instance.new("TextButton", MacBtns)
        btn.Size = MacBtnSize
        btn.Position = UDim2.new(0, xOffset, 0.5, -MacBtnSize.Y.Offset/2)
        btn.BackgroundColor3 = color
        btn.Text = ""
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        animateBtnHover(btn, color)
        if action then
            btn.MouseButton1Click:Connect(function()
                tween(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, MacBtnSize.X.Offset-2, 0, MacBtnSize.Y.Offset-2)})
                task.wait(0.1)
                tween(btn, TweenInfo.new(0.1), {Size = MacBtnSize})
                action()
            end)
        end
        return btn
    end
    createMacBtn(Theme.Close, 0, function()
        tween(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), Rotation = 10})
        tween(MainGlow, TweenInfo.new(0.3), {BackgroundTransparency = 1})
        tween(MainStroke, TweenInfo.new(0.3), {Transparency = 1})
        task.wait(0.4)
        ScreenGui:Destroy()
        WatermarkGui:Destroy()
        if CoreGui:FindFirstChild("GeminiESP") then CoreGui["GeminiESP"]:Destroy() end
    end)
    createMacBtn(Theme.Hide, MacBtnOffset, function()
        isMinimized = not isMinimized
        if isMinimized then
            local function saveAndHide(obj)
                if obj:IsA("GuiObject") then
                    originalTransparency[obj] = {bg = obj.BackgroundTransparency, txt = (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.TextTransparency or nil}
                    tween(obj, TweenInfo.new(0.2), {BackgroundTransparency = 1})
