    RingInner.Position = UDim2.new(0.14, 0, 0.14, 0)
    RingInner.BackgroundColor3 = Color3.fromRGB(10, 5, 15)
    RingInner.BorderSizePixel = 0
    Instance.new("UICorner", RingInner).CornerRadius = UDim.new(1, 0)

    local PercentText = Instance.new("TextLabel", RingContainer)
    PercentText.Size = UDim2.new(1, 0, 1, 0)
