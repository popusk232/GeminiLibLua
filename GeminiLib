        local btn = Instance.new("TextButton", MacBtns)
        btn.Size = MacBtnSize
        btn.Position = UDim2.new(0, xOffset, 0.5, -MacBtnSize.Y.Offset/2)
        btn.BackgroundColor3 = color
        btn.Text = ""
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        animateBtnHover(btn, color)

        if action then
            btn.MouseButton1Click:Connect(function()
                tween(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, MacBtnSize.X.Offset-2, 0, MacBtnSize.Y.Offset-2)})
                task.wait(0.1)
                tween(btn, TweenInfo.new(0.1), {Size = MacBtnSize})
                action()
            end)
