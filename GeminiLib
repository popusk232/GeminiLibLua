                local check = Instance.new("Frame", box)
                check.Size = UDim2.new(0, 10, 0, 10)
                check.Position = UDim2.new(0.5, -5, 0.5, -5)
                check.BackgroundColor3 = color
                check.BorderSizePixel = 0
                check.Visible = false
                Instance.new("UICorner", check).CornerRadius = UDim.new(0, 2)

                -- Label
                local label = Instance.new("TextLabel", row)
                label.Size = UDim2.new(1, -44, 1, 0)
                label.Position = UDim2.new(0, 36, 0, 0)
                label.BackgroundTransparency = 1
                label.Text = option
                label.TextColor3 = color
                label.Font = Enum.Font.Gotham
                label.TextSize = 14
                label.TextXAlignment = Enum.TextXAlignment.Left

                local function toggleOption()
                    results[option] = not results[option]
                    check.Visible = results[option]

                    if results[option] then
                        tween(check, TweenInfo.new(0.1), {Size = UDim2.new(0, 10, 0, 10)})
                        tween(boxStroke, TweenInfo.new(0.15), {Transparency = 0})
                    else
                        tween(boxStroke, TweenInfo.new(0.15), {Transparency = 0.4})
                    end

                    local selectedCount = 0
                    for _, v in pairs(results) do if v then selectedCount = selectedCount + 1 end end
                    counter.Text = tostring(selectedCount)

                    if callback then callback(results) end
                end

                box.MouseButton1Click:Connect(toggleOption)
                row.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        toggleOption()
                    end
                end)

                checkboxes[option] = {box = box, check = check, stroke = boxStroke}
            end

            local function toggleDropdown()
                isOpen = not isOpen
                if isOpen then
                    tween(arrow, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 90})
                    divider.Visible = true
                    optionsContainer.Visible = true
                    tween(container, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.new(1, 0, 0, headerHeight + (#options * itemHeight))
                    })
                else
                    tween(arrow, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 0})
                    tween(container, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Size = UDim2.new(1, 0, 0, headerHeight)
                    })
                    task.delay(0.25, function()
                        if not isOpen then
                            divider.Visible = false
                            optionsContainer.Visible = false
                        end
                    end)
                end
            end

            headerBtn.MouseButton1Click:Connect(toggleDropdown)

            return {
                Get = function() return results end,
                Set = function(option, value)
                    if results[option] ~= nil and results[option] ~= value then
                        results[option] = value
                        local cb = checkboxes[option]
                        cb.check.Visible = value
                        if value then
                            tween(cb.stroke, TweenInfo.new(0.15), {Transparency = 0})
                        else
                            tween(cb.stroke, TweenInfo.new(0.15), {Transparency = 0.4})
                        end
                        local selectedCount = 0
                        for _, v in pairs(results) do if v then selectedCount = selectedCount + 1 end end
                        counter.Text = tostring(selectedCount)
                        if callback then callback(results) end
                    end
                end
            }
        end

        function Tab:AddLabel(text)
            local lbl = Instance.new("TextLabel", Page)
            lbl.Size = UDim2.new(1, 0, 0, 22)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = Theme.SubText
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 14
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            return lbl
        end

        table.insert(Tabs, Tab)
        return Tab
    end

    -- Activate first tab
    function Window:SelectFirstTab()
        if #Tabs > 0 then
            Tabs[1]:Select()
        end
    end

    -- Show UI with animation
    function Window:Show()
        ScreenGui.Enabled = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        MainFrame.Visible = true

        tween(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = FrameSize,
            Position = FramePos
        })

        WatermarkGui.Enabled = true
        local wf = WatermarkGui:FindFirstChildOfClass("Frame")
        if wf then
            wf.Position = UDim2.new(0.5, -200, 0, -40)
            tween(wf, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, -200, 0, 10)
            })
        end
    end


    -- ═══════════════════════════════════════════════════════════════
    --  ESP SYSTEM
    -- ═══════════════════════════════════════════════════════════════
    local ESPFolder = Instance.new("Folder", CoreGui)
    ESPFolder.Name = "GeminiESP"

    local function isInvisible(plr)
        if not plr.Character then return false end
        local hum = plr.Character:FindFirstChild("Humanoid")
        if not hum then return false end
        local head = plr.Character:FindFirstChild("Head")
        if head and head.Transparency > 0.5 then return true end
        for _, part in pairs(plr.Character:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                if part.Transparency > 0.5 then return true end
            end
        end
        return false
    end

    local function createESP(plr)
        if plr == player then return end
        local oldFolder = ESPFolder:FindFirstChild(plr.Name)
        if oldFolder then oldFolder:Destroy() end

        local espFolder = Instance.new("Folder", ESPFolder)
        espFolder.Name = plr.Name
        local espConnection = nil

        local function updateESP()
            if espConnection then
                espConnection:Disconnect()
                espConnection = nil
            end
            for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end

            if not _G.GeminiConfig.ESPEnabled or not plr.Character then
                return
            end
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local billboard = Instance.new("BillboardGui", espFolder)
            billboard.Adornee = hrp
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true

            local invis = isInvisible(plr)
            local nameColor = invis and Theme.Invisible or Theme.Accent

            local nameLabel = Instance.new("TextLabel", billboard)
            nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = plr.Name .. (invis and " [I]" or "")
            nameLabel.TextColor3 = nameColor
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 17
            nameLabel.TextStrokeTransparency = 0.5

            local distLabel = Instance.new("TextLabel", billboard)
            distLabel.Size = UDim2.new(1, 0, 0.5, 0)
            distLabel.Position = UDim2.new(0, 0, 0.5, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.TextColor3 = Theme.SubText
            distLabel.Font = Enum.Font.Gotham
            distLabel.TextSize = 15
            distLabel.TextStrokeTransparency = 0.5

            local highlight = Instance.new("Highlight", espFolder)
            highlight.Adornee = plr.Character
            highlight.FillColor = nameColor
            highlight.OutlineColor = nameColor
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0

            espConnection = RunService.RenderStepped:Connect(function()
                if not _G.GeminiConfig.ESPEnabled or not plr.Character or not player.Character then
                    if espConnection then
                        espConnection:Disconnect()
                        espConnection = nil
                    end
                    return
                end
                local myHrp = player.Character:FindFirstChild("HumanoidRootPart")
                if myHrp and hrp then
                    distLabel.Text = math.floor((myHrp.Position - hrp.Position).Magnitude) .. " studs"
                end
            end)
        end

        plr.CharacterAdded:Connect(function()
            task.wait(0.5)
            updateESP()
        end)
        updateESP()
    end

    local espSetupDone = false
    function Window:SetupESP()
        if espSetupDone then return end
        espSetupDone = true
        for _, plr in pairs(Players:GetPlayers()) do
            createESP(plr)
        end
        Players.PlayerAdded:Connect(createESP)
        Players.PlayerRemoving:Connect(function(plr)
            local f = ESPFolder:FindFirstChild(plr.Name)
            if f then f:Destroy() end
        end)
    end

    -- ═══════════════════════════════════════════════════════════════
    --  AUTO FARM LOOP
    -- ═══════════════════════════════════════════════════════════════
    task.spawn(function()
        while task.wait(0.1) do
            if _G.GeminiConfig.FarmEnabled and player.Character then
                pcall(function()
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local target, minP = nil, 99
                        local priorities = {Secret = 1, Godly = 2, Mythic = 3, Legendary = 4, Epic = 5, Rare = 6, Uncommon = 7, Common = 8}

                        for _, v in pairs(workspace:GetChildren()) do
                            if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                                local r = v:GetAttribute("Rarity") or "Common"
                                if _G.GeminiConfig.SelectedRarities[r] and priorities[r] then
                                    if priorities[r] < minP then
                                        minP = priorities[r]
                                        target = v
                                    end
                                end
                            end
                        end

                        if target and target.Parent then
                            pcall(function()
                                root.CFrame = target:GetPivot() * CFrame.new(0, 3, 0)
                            end)
                            task.wait(0.2)
                            pcall(function()
                                local det = target:FindFirstChildOfClass("ClickDetector") or target:FindFirstChild("ClickDetector", true)
                                if det and fireclickdetector then 
                                    fireclickdetector(det) 
                                elseif det then
                                    warn("GEMINI: fireclickdetector not supported by your executor")
                                end
                            end)
                            task.wait(_G.GeminiConfig.TweenSpeed / 1000)
                        end
                    end
                end)
            end
        end
    end)

    -- ═══════════════════════════════════════════════════════════════
    --  CRATE COUNTER LOOP
    -- ═══════════════════════════════════════════════════════════════
    task.spawn(function()
        while task.wait(1) do
            local count = 0
            for _, v in pairs(workspace:GetChildren()) do
                if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                    local r = v:GetAttribute("Rarity") or "Common"
                    if _G.GeminiConfig.SelectedRarities[r] then
                        count = count + 1
                    end
                end
            end
            StatusLabel.Text = "Target Crates: " .. count
            if count > 0 then
                StatusSub.Text = "Farming active"
                StatusSub.TextColor3 = Theme.Success
            else
                StatusSub.Text = "No targets found"
                StatusSub.TextColor3 = Theme.SubText
            end
        end
    end)

    -- ═══════════════════════════════════════════════════════════════
    --  QUICK LOOT FUNCTION
    -- ═══════════════════════════════════════════════════════════════
    _G.GeminiQuickLoot = function()
        local priorities = {Secret = 1, Godly = 2, Mythic = 3, Legendary = 4, Epic = 5, Rare = 6, Uncommon = 7, Common = 8}
        local best, minP = nil, 99

        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                local r = v:GetAttribute("Rarity") or "Common"
                if _G.GeminiConfig.SelectedRarities[r] and priorities[r] and priorities[r] < minP then
                    minP = priorities[r]
                    best = v
                end
            end
        end

        if best and best.Parent and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                pcall(function()
                    root.CFrame = best:GetPivot() * CFrame.new(0, 3, 0)
                end)
                task.wait(0.2)
                pcall(function()
                    local det = best:FindFirstChildOfClass("ClickDetector") or best:FindFirstChild("ClickDetector", true)
                    if det and fireclickdetector then 
                        fireclickdetector(det) 
                    elseif det then
                        warn("GEMINI: fireclickdetector not supported")
                    end
                end)
            end
        end
    end

    return Window
end

