                Position = UDim2.new(0.03, 0, 0.03, 0)
            })
            tween(RingGlow, TweenInfo.new(1.2), {BackgroundTransparency = 0.8})
            task.wait(1.2)
            tween(RingFill, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0.9, 0, 0.9, 0),
                Position = UDim2.new(0.05, 0, 0.05, 0)
            })
            tween(RingGlow, TweenInfo.new(1.2), {BackgroundTransparency = 0.9})
            task.wait(1.2)
        end
    end)

    -- Loading steps
    local steps = {
        {0, "Initializing core systems"},
        {15, "Loading neural modules"},
        {30, "Establishing secure connection"},
        {50, "Building holographic interface"},
        {70, "Calibrating ESP sensors"},
        {85, "Optimizing performance"},
        {100, "System ready"}
    }

    local progress = 0
    local loadingActive = true

    -- Typing effect function
    local function typeText(text)
        StatusText.Text = ""
        for i = 1, #text do
            if not loadingActive then return end
            StatusText.Text = string.sub(text, 1, i)
            task.wait(0.03)
        end
    end

    task.spawn(function()
        for _, step in ipairs(steps) do
            local target, status = step[1], step[2]
            typeText(status)

            while progress < target do
                progress = progress + 1
                PercentText.Text = progress .. "%"
                local scale = 0.75 + (progress / 100) * 0.15
                RingInner.Size = UDim2.new(scale, 0, scale, 0)
                RingInner.Position = UDim2.new((1 - scale) / 2, 0, (1 - scale) / 2, 0)
                task.wait(duration / 100)
            end
            task.wait(0.4)
        end

        task.wait(0.6)
        loadingActive = false
        StatusText.Text = "Welcome, " .. (player.DisplayName or player.Name)

        -- Fade out with style
        tween(LoaderFrame, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1})
        for _, child in pairs(Center:GetDescendants()) do
            if child:IsA("TextLabel") then
                tween(child, TweenInfo.new(0.8), {TextTransparency = 1})
            elseif child:IsA("Frame") and child ~= RingContainer then
                tween(child, TweenInfo.new(0.8), {BackgroundTransparency = 1})
            end
        end
        tween(RingContainer, TweenInfo.new(0.8), {Size = UDim2.new(0, 0, 0, 0)})

        task.wait(1)
        LoaderGui:Destroy()
    end)

    return LoaderGui
end

