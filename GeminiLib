            bar.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
            bar.BorderSizePixel = 0
            Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame", bar)
            fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Theme.Accent
            fill.BorderSizePixel = 0
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

            local fillGlow = Instance.new("Frame", fill)
            fillGlow.Size = UDim2.new(1, 0, 1, 4)
            fillGlow.Position = UDim2.new(0, 0, 0, -2)
            fillGlow.BackgroundColor3 = Theme.Accent
            fillGlow.BackgroundTransparency = 0.8
            fillGlow.ZIndex = -1
            Instance.new("UICorner", fillGlow).CornerRadius = UDim.new(1, 0)

            local circle = Instance.new("Frame", bar)
            circle.Size = UDim2.new(0, 18, 0, 18)
            circle.Position = UDim2.new((default - min) / (max - min), -9, 0.5, -9)
            circle.BackgroundColor3 = Theme.Text
            circle.BorderSizePixel = 0
            circle.ZIndex = 2
            Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

            local circleStroke = Instance.new("UIStroke", circle)
            circleStroke.Color = Theme.Accent
            circleStroke.Thickness = 3

            local sliding = false

            local function update()
                local mx = UserInputService:GetMouseLocation().X
                local bx = bar.AbsolutePosition.X
                local bw = bar.AbsoluteSize.X
                local pos = math.clamp((mx - bx) / bw, 0, 1)
                tween(fill, TweenInfo.new(0.1), {Size = UDim2.new(pos, 0, 1, 0)})
                tween(circle, TweenInfo.new(0.1), {Position = UDim2.new(pos, -9, 0.5, -9)})
                local val = math.floor(min + (max - min) * pos)
                label.Text = text .. ": " .. val
                if callback then callback(val) end
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    tween(circle, TweenInfo.new(0.15), {Size = UDim2.new(0, 22, 0, 22)})
                    update()
                end
            end)
            circle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    tween(circle, TweenInfo.new(0.15), {Size = UDim2.new(0, 22, 0, 22)})
                    update()
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = false
                    tween(circle, TweenInfo.new(0.15), {Size = UDim2.new(0, 18, 0, 18)})
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    update()
                end
            end)

            return {Set = function(v)
                local pos = (v - min) / (max - min)
                tween(fill, TweenInfo.new(0.2), {Size = UDim2.new(pos, 0, 1, 0)})
                tween(circle, TweenInfo.new(0.2), {Position = UDim2.new(pos, -9, 0.5, -9)})
                label.Text = text .. ": " .. v
            end}
        end

