    createMacBtn(Theme.Hide, MacBtnOffset, function()
        isMinimized = not isMinimized
        if isMinimized then
            -- Сохраняем и скрываем ВСЁ кроме TopBar
            local function saveAndHide(obj)
                if obj:IsA("GuiObject") then
                    originalTransparency[obj] = {
                        bg = obj.BackgroundTransparency,
                        txt = (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.TextTransparency or nil
                    }
                    tween(obj, TweenInfo.new(0.2), {BackgroundTransparency = 1})
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        tween(obj, TweenInfo.new(0.2), {TextTransparency = 1})
                    end
                end
                for _, c in pairs(obj:GetChildren()) do saveAndHide(c) end
            end

            -- Скрываем всё КРОМЕ TopBar
            for _, child in pairs(MainFrame:GetChildren()) do
                if child ~= TopBar then
                    saveAndHide(child)
                end
            end
            -- Скрываем содержимое TopBar кроме MacBtns
            for _, child in pairs(TopBar:GetChildren()) do
                if child ~= MacBtns then
                    saveAndHide(child)
                end
            end

            -- Свертываем в маленькую плашку (только TopBar виден)
            tween(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 140 * UIScale, 0, 40 * UIScale),
                Position = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset),
                BackgroundTransparency = 0.9
            })
            tween(MainStroke, TweenInfo.new(0.3), {Transparency = 0.8})
            tween(MainGlow, TweenInfo.new(0.3), {BackgroundTransparency = 1})
        else
            -- Восстанавливаем
            tween(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = FrameSize, Position = FramePos, BackgroundTransparency = 0
            })
            tween(MainStroke, TweenInfo.new(0.4), {Transparency = 0.4})
            tween(MainGlow, TweenInfo.new(0.4), {BackgroundTransparency = 0.95})

            local function restore(obj)
                if originalTransparency[obj] then
                    local d = originalTransparency[obj]
                    tween(obj, TweenInfo.new(0.3), {BackgroundTransparency = d.bg})
                    if d.txt ~= nil then tween(obj, TweenInfo.new(0.3), {TextTransparency = d.txt}) end
                end
                for _, c in pairs(obj:GetChildren()) do restore(c) end
            end

            for _, child in pairs(MainFrame:GetChildren()) do
                if child ~= TopBar then
                    restore(child)
                end
            end
            for _, child in pairs(TopBar:GetChildren()) do
                if child ~= MacBtns then
                    restore(child)
                end
            end
        end
    end)

