                local currentTime = tick()
                if currentTime - lastTime >= 1 then
                    FPSLabel.Text = "FPS: " .. frameCount
                    frameCount = 0
                    lastTime = currentTime
                end
                task.wait()
            end
        end)
    end

    -- Time update loop
    if showTime then
        task.spawn(function()
            while WatermarkGui.Parent do
                local timeStr = os.date("%H:%M:%S")
                TimeLabel.Text = timeStr
                task.wait(1)
            end
        end)
    end

    -- Crate scanning loop
    if showCrates then
        task.spawn(function()
            while WatermarkGui.Parent do
                local crates = {}
                local bestCrate = nil
                local bestP = 99
                local priorities = {Secret = 1, Godly = 2, Mythic = 3, Legendary = 4, Epic = 5, Rare = 6, Uncommon = 7, Common = 8}

                for _, v in pairs(workspace:GetChildren()) do
                    if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                        local r = v:GetAttribute("Rarity") or "Common"
                        local name = v:GetAttribute("CrateName") or v.Name or "Unknown"
                        if not crates[r] then crates[r] = {count = 0, names = {}} end
                        crates[r].count = crates[r].count + 1
                        table.insert(crates[r].names, name)

                        local p = priorities[r] or 99
                        if p < bestP then
                            bestP = p
                            bestCrate = {rarity = r, name = name, obj = v}
                        end
                    end
                end

                if bestCrate then
                    local col = Theme.RarityColors[bestCrate.rarity] or Theme.Text
                    local r, g, b = math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255)

                    local parts = {}
                    for rarity, data in pairs(crates) do
                        local c = Theme.RarityColors[rarity] or Theme.Text
                        local rr, gg, bb = math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255)
                        table.insert(parts, string.format('<font color="rgb(%d,%d,%d)">%s:%d</font>', rr, gg, bb, rarity, data.count))
                    end

                    table.sort(parts, function(a, b)
                        local function p(str)
                            if str:find("Secret") then return 1 end
                            if str:find("Godly") then return 2 end
                            if str:find("Mythic") then return 3 end
                            if str:find("Legendary") then return 4 end
                            if str:find("Epic") then return 5 end
                            if str:find("Rare") then return 6 end
                            return 7
                        end
                        return p(a) < p(b)
                    end)

                    CrateInfo.Text = string.format('<font color="rgb(%d,%d,%d)">★ %s</font> | %s', r, g, b, bestCrate.rarity:upper(), table.concat(parts, "  •  "))
                else
                    CrateInfo.Text = '<font color="rgb(150,150,150)">No crates detected in workspace</font>'
                end

                tween(CrateInfo, TweenInfo.new(0.3), {TextTransparency = 0})
                task.wait(2)
            end
        end)
    end

    return WatermarkGui
end


