if not string.find(executor, "Solara") then
    game:GetService("Players").LocalPlayer:Kick("GEMINI: This script is only for Solara executor!")
    return
end

_G.GeminiLib = nil

local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local player = Players.LocalPlayer

local Theme = {
    Main = Color3.fromRGB(15, 15, 20),
    Sidebar = Color3.fromRGB(10, 10, 15),
    Accent = Color3.fromRGB(0, 255, 255),
    Element = Color3.fromRGB(25, 25, 30),
    Text = Color3.fromRGB(255, 255, 255),
    SubText = Color3.fromRGB(180, 180, 180),
    Close = Color3.fromRGB(255, 80, 80),
    Hide = Color3.fromRGB(255, 200, 50),
    Success = Color3.fromRGB(0, 255, 150),
    RarityColors = {Secret = Color3.fromRGB(255, 50, 50), Godly = Color3.fromRGB(255, 215, 0), Mythic = Color3.fromRGB(180, 50, 255), Legendary = Color3.fromRGB(255, 140, 0), Epic = Color3.fromRGB(150, 50, 255), Rare = Color3.fromRGB(50, 150, 255), Uncommon = Color3.fromRGB(50, 200, 100), Common = Color3.fromRGB(200, 200, 200)}
}

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local GeminiLib = {}
_G.GeminiLib = GeminiLib

_G.GeminiConfig = {
    FarmEnabled = false,
    TweenSpeed = 1200,
    ESPEnabled = false,
    SelectedRarities = {Secret = true, Godly = true, Mythic = true, Legendary = false, Epic = false, Rare = false, Uncommon = false, Common = false},
    MenuKey = Enum.KeyCode.Insert
}
_G.GeminiStats = {Secret = 0, Godly = 0, Mythic = 0, Legendary = 0, Epic = 0, Rare = 0, Uncommon = 0, Common = 0, Total = 0}

function GeminiLib:Notify(text, type, duration)
    local NotifGui = CoreGui:FindFirstChild("GeminiNotifications")
    if not NotifGui then
        NotifGui = Instance.new("ScreenGui", CoreGui)
        NotifGui.Name = "GeminiNotifications"
        local c = Instance.new("Frame", NotifGui)
        c.Name = "Container"
        c.Size = UDim2.new(0, 250, 1, 0)
        c.Position = UDim2.new(1, -260, 0, 0)
        c.BackgroundTransparency = 1
        Instance.new("UIListLayout", c).VerticalAlignment = Enum.VerticalAlignment.Bottom
        NotifGui.Container.UIListLayout.Padding = UDim.new(0, 10)
    end
    local frame = Instance.new("Frame", NotifGui.Container)
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundColor3 = Theme.Sidebar
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", frame).Color = type == "Success" and Theme.Success or Theme.Accent
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Theme.Text
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    frame.Position = UDim2.new(1.5, 0, 0, 0)
    tween(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
    task.delay(duration or 3, function()
        if frame and frame.Parent then
            tween(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = UDim2.new(1.5, 0, 0, 0)})
            task.wait(0.5)
            if frame and frame.Parent then frame:Destroy() end
        end
    end)
end

function GeminiLib:SaveConfig()
    pcall(function()
        local data = {TweenSpeed = _G.GeminiConfig.TweenSpeed, SelectedRarities = _G.GeminiConfig.SelectedRarities, MenuKey = _G.GeminiConfig.MenuKey.Name}
        writefile("GeminiConfig.json", HttpService:JSONEncode(data))
        GeminiLib:Notify("Config Saved!", "Success")
    end)
end

function GeminiLib:LoadConfig()
    if isfile("GeminiConfig.json") then
        pcall(function()
            local data = HttpService:JSONDecode(readfile("GeminiConfig.json"))
            _G.GeminiConfig.TweenSpeed = data.TweenSpeed or 1200
            _G.GeminiConfig.SelectedRarities = data.SelectedRarities or _G.GeminiConfig.SelectedRarities
            if data.MenuKey then _G.GeminiConfig.MenuKey = Enum.KeyCode[data.MenuKey] end
            GeminiLib:Notify("Config Loaded!", "Success")
        end)
    end
end

player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

function GeminiLib:Init(config)
    config = config or {}
    GeminiLib:LoadConfig()
    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = config.Name or "GeminiUI"
    ScreenGui.IgnoreGuiInset = true
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 520, 0, 360)
    MainFrame.Position = UDim2.new(0.5, -260, 0.5, -180)
    MainFrame.BackgroundColor3 = Theme.Main
    MainFrame.BorderSizePixel = 0
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)
    local MainStroke = Instance.new("UIStroke", MainFrame)
    MainStroke.Color = Theme.Accent
    local TopBar = Instance.new("Frame", MainFrame)
    TopBar.Size = UDim2.new(1, 0, 0, 35)
    TopBar.BackgroundTransparency = 1
    local dragging, dragStart, startPos
    TopBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true dragStart = input.Position startPos = MainFrame.Position end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then local delta = input.Position - dragStart MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputBegan:Connect(function(input, gpe) if not gpe and input.KeyCode == _G.GeminiConfig.MenuKey then MainFrame.Visible = not MainFrame.Visible end end)
    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.Size = UDim2.new(0, 140, 1, -35)
    Sidebar.Position = UDim2.new(0, 0, 0, 35)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BorderSizePixel = 0
    local TabContainer = Instance.new("ScrollingFrame", Sidebar)
    TabContainer.Size = UDim2.new(1, 0, 1, -80)
    TabContainer.Position = UDim2.new(0, 0, 0, 5)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 0
    Instance.new("UIListLayout", TabContainer).HorizontalAlignment = Enum.HorizontalAlignment.Center
    local StatsPanel = Instance.new("Frame", Sidebar)
    StatsPanel.Size = UDim2.new(1, -10, 0, 70)
    StatsPanel.Position = UDim2.new(0, 5, 1, -75)
    StatsPanel.BackgroundColor3 = Theme.Element
    Instance.new("UICorner", StatsPanel).CornerRadius = UDim.new(0, 6)
    local StatsText = Instance.new("TextLabel", StatsPanel)
    StatsText.Size = UDim2.new(1, -10, 1, -10)
    StatsText.Position = UDim2.new(0, 5, 0, 5)
    StatsText.BackgroundTransparency = 1
    StatsText.TextColor3 = Theme.SubText
    StatsText.Font = Enum.Font.GothamBold
    StatsText.TextSize = 9
    StatsText.TextXAlignment = Enum.TextXAlignment.Left
    task.spawn(function()
        while task.wait(1) do
            StatsText.Text = string.format("TOTAL: %d\nSECRET: %d\nGODLY: %d\nMYTHIC: %d", _G.GeminiStats.Total, _G.GeminiStats.Secret, _G.GeminiStats.Godly, _G.GeminiStats.Mythic)
        end
    end)
    local Container = Instance.new("Frame", MainFrame)
    Container.Size = UDim2.new(1, -160, 1, -45)
    Container.Position = UDim2.new(0, 150, 0, 40)
    Container.BackgroundTransparency = 1
    local Window = {}
    function Window:AddTab(name)
        local Tab = {}
        local Page = Instance.new("ScrollingFrame", Container)
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.Visible = false
        Page.ScrollBarThickness = 0
        Instance.new("UIListLayout", Page).Padding = UDim.new(0, 5)
        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(0.9, 0, 0, 30)
        TabBtn.BackgroundColor3 = Theme.Element
        TabBtn.Text = name
        TabBtn.TextColor3 = Theme.SubText
        TabBtn.Font = Enum.Font.Gotham
        TabBtn.TextSize = 12
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 4)
        function Tab:Select()
            for _, v in pairs(Container:GetChildren()) do if v:IsA("ScrollingFrame") then v.Visible = false end end
            for _, v in pairs(TabContainer:GetChildren()) do if v:IsA("TextButton") then v.TextColor3 = Theme.SubText end end
            Page.Visible = true
            TabBtn.TextColor3 = Theme.Accent
        end
        TabBtn.MouseButton1Click:Connect(function() Tab:Select() end)
        function Tab:AddToggle(text, callback)
            local btn = Instance.new("TextButton", Page)
            btn.Size = UDim2.new(1, 0, 0, 35)
            btn.BackgroundColor3 = Theme.Element
            btn.Text = " " .. text
            btn.TextColor3 = Theme.Text
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            local state = false
            btn.MouseButton1Click:Connect(function() state = not state btn.TextColor3 = state and Theme.Accent or Theme.Text if callback then callback(state) end end)
        end
        function Tab:AddSlider(text, min, max, default, callback)
            local frame = Instance.new("Frame", Page)
            frame.Size = UDim2.new(1, 0, 0, 45)
            frame.BackgroundColor3 = Theme.Element
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
            local label = Instance.new("TextLabel", frame)
            label.Size = UDim2.new(1, -20, 0, 20)
            label.Position = UDim2.new(0, 10, 0, 5)
            label.Text = text .. ": " .. default
            label.TextColor3 = Theme.Text
            label.Font = Enum.Font.Gotham
            label.TextSize = 11
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            local bar = Instance.new("Frame", frame)
            bar.Size = UDim2.new(1, -20, 0, 4)
            bar.Position = UDim2.new(0, 10, 0, 30)
            bar.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            local fill = Instance.new("Frame", bar)
            fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Theme.Accent
            local sliding = false
            local function update()
                local pos = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                local val = math.floor(min + (max - min) * pos)
                label.Text = text .. ": " .. val
                if callback then callback(val) end
            end
            bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true update() end end)
            UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
            UserInputService.InputChanged:Connect(function(input) if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update() end end)
        end
        function Tab:AddButton(text, callback)
            local btn = Instance.new("TextButton", Page)
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Theme.Accent
            btn.Text = text
            btn.TextColor3 = Theme.Main
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 12
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            btn.MouseButton1Click:Connect(function() if callback then callback() end end)
        end
        function Tab:AddKeybind(text, default, callback)
            local btn = Instance.new("TextButton", Page)
            btn.Size = UDim2.new(1, 0, 0, 35)
            btn.BackgroundColor3 = Theme.Element
            btn.Text = " " .. text .. ": " .. default.Name
            btn.TextColor3 = Theme.Text
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            btn.MouseButton1Click:Connect(function()
                btn.Text = " ... Press any key"
                local connection
                connection = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        btn.Text = " " .. text .. ": " .. input.KeyCode.Name
                        if callback then callback(input.KeyCode) end
                        connection:Disconnect()
                    end
                end)
            end)
        end
        function Tab:AddDropdown(title, options, callback)
            local btn = Instance.new("TextButton", Page)
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Theme.Element
            btn.Text = title
            btn.TextColor3 = Theme.Text
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 12
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            local results = {}
            for _, v in pairs(options) do results[v] = _G.GeminiConfig.SelectedRarities[v] or false end
            btn.MouseButton1Click:Connect(function() if callback then callback(results) end end)
            return {Set = function(opt, val) results[opt] = val end}
        end
        return Tab
    end
    function Window:SelectFirstTab()
        local first = Container:FindFirstChildOfClass("ScrollingFrame")
        if first then first.Visible = true end
        local firstBtn = TabContainer:FindFirstChildOfClass("TextButton")
        if firstBtn then firstBtn.TextColor3 = Theme.Accent end
    end
    function Window:Show() ScreenGui.Enabled = true end
    local ESPFolder = Instance.new("Folder", CoreGui)
    ESPFolder.Name = "GeminiESP"
    local function createESP(plr)
        if plr == player then return end
        local folder = Instance.new("Folder", ESPFolder)
        folder.Name = plr.Name
        RunService.RenderStepped:Connect(function()
            folder:ClearAllChildren()
            if _G.GeminiConfig.ESPEnabled and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local highlight = Instance.new("Highlight", folder)
                highlight.Adornee = plr.Character
                highlight.FillColor = Theme.Accent
            end
        end)
    end
    function Window:SetupESP() for _, v in pairs(Players:GetPlayers()) do createESP(v) end Players.PlayerAdded:Connect(createESP) end
    task.spawn(function()
        while task.wait(0.1) do
            if _G.GeminiConfig.FarmEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    local root = player.Character.HumanoidRootPart
                    local target, minP = nil, 99
                    local priorities = {Secret = 1, Godly = 2, Mythic = 3, Legendary = 4, Epic = 5, Rare = 6, Uncommon = 7, Common = 8}
                    for _, v in pairs(workspace:GetChildren()) do
                        if v:IsA("Model") and v:GetAttribute("SpawnedCrate") then
                            local r = v:GetAttribute("Rarity") or "Common"
                            if _G.GeminiConfig.SelectedRarities[r] and priorities[r] and priorities[r] < minP then minP = priorities[r] target = v end
                        end
                    end
                    if target then
                        local rarity = target:GetAttribute("Rarity") or "Common"
                        root.CFrame = target:GetPivot() * CFrame.new(0, 3, 0)
                        task.wait(0.2)
                        local det = target:FindFirstChildOfClass("ClickDetector") or target:FindFirstChild("ClickDetector", true)
                        if det and fireclickdetector then
                            fireclickdetector(det)
                            _G.GeminiStats.Total = _G.GeminiStats.Total + 1
                            _G.GeminiStats[rarity] = _G.GeminiStats[rarity] + 1
                            GeminiLib:Notify("Looted " .. rarity .. " crate!", "Success")
                        end
                        task.wait(_G.GeminiConfig.TweenSpeed / 1000)
                    end
                end)
            end
        end
    end)
    return Window
end
return GeminiLib
